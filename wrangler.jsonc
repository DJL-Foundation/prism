{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prism-presentations",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "alias": {
    "#tanstack-router-entry": "./src/router.tsx",
    "#tanstack-start-entry": "./src/server.ts",
    "#tanstack-start-plugin-adapters": "./src/server.ts",
    "tanstack-start-manifest:v": "./src/router.tsx",
    "tanstack-start-injected-head-scripts:v": "./src/router.tsx",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.5,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.25,
    },
  },
  "env": {
    "dev-preview": {
      "name": "prism-presentations-dev",
      "compatibility_date": "2026-05-03",
      "compatibility_flags": ["nodejs_compat"],
      "main": "src/server.ts",
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true,
        },
        "traces": {
          "enabled": true,
          "persist": true,
          "head_sampling_rate": 1,
        },
      },
    },
  },
}
